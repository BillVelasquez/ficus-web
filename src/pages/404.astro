---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Página no encontrada (404) | Ficus ERP" 
  description="La página que busca no existe o fue movida. Regrese a la página principal de Ficus ERP."
>
  <Header />
  <main class="flex-grow flex items-center justify-center py-24 px-4 text-center bg-white">
    <div class="max-w-md space-y-6">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-ficus-50 border border-ficus-200 text-ficus-700 text-3xl font-extrabold">
        404
      </div>
      <h1 class="text-3xl font-extrabold text-slate-900">Página no encontrada</h1>
      <p class="text-slate-600 text-sm">
        Lo sentimos, la ruta a la que intentó acceder no está disponible.
      </p>
      <div>
        <a 
          href="/" 
          class="inline-flex items-center justify-center px-6 py-3 rounded-xl font-bold text-white bg-ficus-700 hover:bg-ficus-800 transition-all shadow-md shadow-ficus-700/20"
        >
          Volver al Inicio
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
