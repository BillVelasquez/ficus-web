---
// Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-canvas border-t border-slate-200/80 py-16 text-slate-600 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 mb-12">
      
      <!-- Brand & Description -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img 
            src="/img/fi_logo.png" 
            alt="Logotipo de Ficus ERP" 
            class="h-8 w-auto object-contain"
            width="32"
            height="32"
            loading="lazy"
          />
          <span class="text-xl font-extrabold tracking-tight text-slate-900">FICUS</span>
        </div>
        <p class="text-sm text-slate-600 leading-relaxed max-w-sm">
          Plataforma de gestión empresarial ágil y personalizable. Integre contabilidad, facturación electrónica DIAN, cartera, nómina e inventarios con el poder de Microsoft Excel y la robustez de un core financiero moderno.
        </p>
        <div class="text-xs text-slate-500 font-medium">
          Operación continua garantizada • Hecho para empresas en crecimiento
        </div>
      </div>

      <!-- Links: Módulos -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Módulos Core</div>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="#modulos" class="hover:text-ficus-700 transition-colors">Contabilidad Multidimensión</a></li>
          <li><a href="#modulos" class="hover:text-ficus-700 transition-colors">Facturación Electrónica DIAN</a></li>
          <li><a href="#modulos" class="hover:text-ficus-700 transition-colors">Gestión de Cartera & RADIAN</a></li>
          <li><a href="#modulos" class="hover:text-ficus-700 transition-colors">Proveedores & Documento Soporte</a></li>
          <li><a href="#modulos" class="hover:text-ficus-700 transition-colors">Inventario PEPS / FIFO</a></li>
          <li><a href="#modulos" class="hover:text-ficus-700 transition-colors">Nómina Electrónica</a></li>
        </ul>
      </div>

      <!-- Links: Plataforma -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Plataforma</div>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="#personalizacion" class="hover:text-ficus-700 transition-colors">Complemento Microsoft Excel</a></li>
          <li><a href="#personalizacion" class="hover:text-ficus-700 transition-colors">Editor de Procesos BPM</a></li>
          <li><a href="#personalizacion" class="hover:text-ficus-700 transition-colors">BUS de Integración APIs</a></li>
          <li><a href="#personalizacion" class="hover:text-ficus-700 transition-colors">Portal de Autoservicio</a></li>
          <li><a href="#garantias" class="hover:text-ficus-700 transition-colors">Estrategia Strangler Fig</a></li>
        </ul>
      </div>

      <!-- Links: Contacto & Empresa -->
      <div class="space-y-3">
        <div class="text-xs font-bold uppercase tracking-wider text-slate-900">Compañía</div>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li><a href="#beneficios" class="hover:text-ficus-700 transition-colors">Beneficios Ficus</a></li>
          <li><a href="#soporte" class="hover:text-ficus-700 transition-colors">Ejecutivos de Cuenta</a></li>
          <li><a href="#garantias" class="hover:text-ficus-700 transition-colors">Garantías Operativas</a></li>
          <li><a href="#contacto" class="hover:text-ficus-700 transition-colors">Solicitar Demostración</a></li>
          <li><a href="https://app.gficus.co" class="hover:text-ficus-700 transition-colors text-ficus-700 font-semibold" target="_blank" rel="noopener">Acceso Clientes Ficus</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        © {currentYear} Ficus Software. Todos los derechos reservados.
      </div>
      <div class="flex items-center gap-6">
        <span>Cumplimiento Normativo DIAN y Estándares NIIF</span>
        <span>Privacidad y Protección de Datos</span>
      </div>
    </div>
  </div>
</footer>
