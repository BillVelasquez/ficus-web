---
import { getEntry } from 'astro:content';

const ctaEntry = await getEntry('sections', '09-cta');
---

<section id="contacto" class="py-20 md:py-28 relative overflow-hidden bg-canvas border-t border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Copy -->
      <div class="lg:col-span-6 space-y-6 text-center lg:text-left">
        <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold tracking-wide bg-ficus-50 border border-ficus-200 text-ficus-800">
          {ctaEntry.data.badge}
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
          {ctaEntry.data.title}
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-xl mx-auto lg:mx-0">
          {ctaEntry.data.subtitle}
        </p>

        <div class="space-y-3 pt-2 text-left max-w-md mx-auto lg:mx-0">
          <div class="flex items-center gap-3 text-sm text-slate-700">
            <svg class="w-5 h-5 text-ficus-700 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span>Demostración con datos reales de su industria</span>
          </div>
          <div class="flex items-center gap-3 text-sm text-slate-700">
            <svg class="w-5 h-5 text-ficus-700 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span>Evaluación de migración en paralelo Strangler Fig</span>
          </div>
          <div class="flex items-center gap-3 text-sm text-slate-700">
            <svg class="w-5 h-5 text-ficus-700 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span>Cero compromiso financiero previo</span>
          </div>
        </div>

        <div class="pt-4 flex items-center justify-center lg:justify-start gap-4">
          <a 
            href="https://wa.me/573100000000?text=Hola%20Ficus,%20deseo%20conocer%20m%C3%A1s%20sobre%20la%20plataforma%20y%20agendar%20una%20demostraci%C3%B3n" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm font-semibold text-ficus-800 bg-ficus-100/70 hover:bg-ficus-100 border border-ficus-200 px-4 py-2 rounded-lg transition-colors"
          >
            <svg class="w-4 h-4 text-ficus-700" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            <span>O chatee directamente por WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- Form Box -->
      <div class="lg:col-span-6">
        <div class="p-8 sm:p-10 rounded-3xl bg-white border border-slate-200 shadow-xl shadow-slate-200/50 relative">
          <h3 class="text-xl font-bold text-slate-900 mb-1">Reserve su Demostración Estratégica</h3>
          <p class="text-xs text-slate-500 mb-6">Uno de nuestros ejecutivos sénior le contactará para coordinar la sesión con datos de su sector.</p>
          
          <form id="demo-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-semibold text-slate-700 mb-1">Nombre Completo *</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  placeholder="Ej: Carolina Restrepo" 
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-ficus-700 focus:bg-white text-sm transition-all"
                />
              </div>
              <div>
                <label for="company" class="block text-xs font-semibold text-slate-700 mb-1">Empresa / Razón Social *</label>
                <input 
                  type="text" 
                  id="company" 
                  name="company" 
                  required 
                  placeholder="Ej: Inversiones Globales S.A.S." 
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-ficus-700 focus:bg-white text-sm transition-all"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="email" class="block text-xs font-semibold text-slate-700 mb-1">Correo Corporativo *</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  placeholder="nombre@suempresa.com" 
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-ficus-700 focus:bg-white text-sm transition-all"
                />
              </div>
              <div>
                <label for="phone" class="block text-xs font-semibold text-slate-700 mb-1">Teléfono / WhatsApp *</label>
                <input 
                  type="tel" 
                  id="phone" 
                  name="phone" 
                  required 
                  placeholder="+57 300 123 4567" 
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-ficus-700 focus:bg-white text-sm transition-all"
                />
              </div>
            </div>

            <div>
              <label for="module_interest" class="block text-xs font-semibold text-slate-700 mb-1">Módulo o Área Prioritaria</label>
              <select 
                id="module_interest" 
                name="module_interest" 
                class="w-full px-4 py-2.5 rounded-xl bg-slate-50 border border-slate-300 text-slate-900 focus:outline-none focus:border-ficus-700 focus:bg-white text-sm transition-all"
              >
                <option value="ERP Integral Completo">Ecosistema Completo (ERP Integral)</option>
                <option value="Contabilidad NIIF">Contabilidad e Informes NIIF</option>
                <option value="Facturación DIAN y RADIAN">Facturación Electrónica DIAN & RADIAN</option>
                <option value="Integración con Excel">Integración con Microsoft Excel</option>
                <option value="Nómina Electrónica">Nómina Electrónica</option>
                <option value="Módulo a la Medida">Desarrollo de Módulo Especial a la Medida</option>
              </select>
            </div>

            <button 
              type="submit" 
              style="background-color: #1e622f; color: #ffffff;"
              class="w-full py-3.5 px-6 rounded-xl text-base font-bold text-white bg-[#1e622f] hover:bg-[#164e28] transition-all shadow-md shadow-ficus-700/20 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 cursor-pointer"
            >
              <span style="color: #ffffff;">Agendar Demostración Personalizada</span>
            </button>

            <!-- Success notification box (revealed on submit) -->
            <div id="form-success" class="hidden p-4 rounded-xl bg-ficus-50 border border-ficus-200 space-y-2 text-center">
              <div class="text-sm font-bold text-ficus-900">
                ✓ Solicitud Recibida Exitosamente
              </div>
              <p class="text-xs text-slate-600">
                Redirigiendo a WhatsApp para confirmar la hora de la sesión con un ejecutivo de cuenta humano...
              </p>
            </div>

            <p class="text-[11px] text-center text-slate-500 pt-1">
              🔒 Sus datos están protegidos bajo estricta confidencialidad. Sin spam ni llamadas automatizadas.
            </p>
          </form>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('demo-form') as HTMLFormElement | null;
  const successBox = document.getElementById('form-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const name = formData.get('name') || '';
    const company = formData.get('company') || '';
    const email = formData.get('email') || '';
    const phone = formData.get('phone') || '';
    const moduleInterest = formData.get('module_interest') || 'ERP Integral';

    if (successBox) {
      successBox.classList.remove('hidden');
    }

    // Build structured WhatsApp message for instant human notification
    const textMsg = encodeURIComponent(
      `Hola equipo Ficus, solicito una demostración personalizada:\n` +
      `• Nombre: ${name}\n` +
      `• Empresa: ${company}\n` +
      `• Correo: ${email}\n` +
      `• Teléfono: ${phone}\n` +
      `• Área de interés: ${moduleInterest}`
    );

    // Open WhatsApp after a brief 1.2s delay so user sees confirmation
    setTimeout(() => {
      window.open(`https://wa.me/573100000000?text=${textMsg}`, '_blank');
    }, 1200);
  });
</script>
