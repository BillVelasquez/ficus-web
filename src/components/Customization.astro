---
import { getEntry } from 'astro:content';

const customEntry = await getEntry('sections', '06-customization');

const tools = [
  {
    title: "Adaptación de Base de Datos",
    subtitle: "Tablas Maestras y Formularios Dinámicos",
    desc: "Cree modelos de datos personalizados, campos calculados y relaciones complejas sin tocar código fuente ni romper futuras actualizaciones.",
    points: ["Diseñador visual de formularios de captura", "Gestión de archivos adjuntos en cada transacción", "Validación estricta de integridad de datos"]
  },
  {
    title: "Editor de Procesos de Negocio (BPM)",
    subtitle: "Automatice Flujos y Aprobaciones",
    desc: "Defina circuitos de autorización jerárquicos multinivel (por montos, centros de costos o roles) con notificaciones automáticas y semáforos SLA.",
    points: ["Diseñador de flujos de trabajo sin código", "Permisos granulares por usuario y equipo", "Historial de auditoría y firmas digitales"]
  },
  {
    title: "BUS de Integración Empresarial",
    subtitle: "Conexión con Cualquier Sistema de Terceros",
    desc: "Evite la doble digitación. Ficus se conecta con su eCommerce, CRM comercial, básculas o sistemas heredados de forma transparente.",
    points: ["APIs RESTful seguras y Webhooks en tiempo real", "Procesamiento por lotes y archivos de interfaz", "Conexión directa a bases de datos corporativas"]
  },
  {
    title: "Conector Oficial Microsoft Excel",
    subtitle: "La Potencia de Excel + Seguridad ERP",
    desc: "Cree datos maestros masivos desde hojas de cálculo y use fórmulas Ficus personalizadas para actualizar sus reportes financieros en vivo.",
    points: ["Funciones personalizadas en Excel", "Validación y carga masiva sin errores", "Trazabilidad y permisos de usuario respetados"]
  },
  {
    title: "Portal de Autoservicio B2B",
    subtitle: "Para Clientes y Proveedores",
    desc: "Elimine correos manuales. Sus clientes y proveedores pueden radicar documentos, descargar certificados de retención y consultar saldos.",
    points: ["Descarga 24/7 de certificados tributarios", "Recepción y validación de facturas electrónicas", "Consulta en tiempo real del estado de pagos"]
  }
];

const customCapabilities = [
  "Importaciones y Comercio Exterior",
  "Gestión de Calidad ISO",
  "Pipeline de Cotizaciones & CRM",
  "Administración de Arrendamientos",
  "Planeación de Producción (MRP)",
  "Gestión de Garantías Técnicas"
];
---

<section id="personalizacion" class="py-20 md:py-32 relative overflow-hidden bg-canvas">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold tracking-wide bg-ficus-50 border border-ficus-200 text-ficus-800">
        {customEntry.data.badge}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        {customEntry.data.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        {customEntry.data.subtitle}
      </p>
    </div>

    <!-- Tools Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {tools.map((tool) => (
        <div class="p-8 rounded-2xl bg-white border border-slate-200 hover:border-ficus-500/70 transition-all duration-300 shadow-sm hover:shadow-md flex flex-col justify-between">
          <div class="space-y-3">
            <span class="text-xs font-bold text-ficus-700 uppercase tracking-wider">{tool.subtitle}</span>
            <h3 class="text-xl font-bold text-slate-900">{tool.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{tool.desc}</p>
            <ul class="space-y-2 pt-3 border-t border-slate-100">
              {tool.points.map((pt) => (
                <li class="flex items-center gap-2 text-xs text-slate-500">
                  <span class="w-1.5 h-1.5 rounded-full bg-ficus-600"></span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}

      <!-- Special Highlight Card: Soluciones a la medida -->
      <div class="p-8 rounded-2xl bg-ficus-50/80 border border-ficus-200 shadow-sm flex flex-col justify-between">
        <div class="space-y-3">
          <span class="text-xs font-bold text-ficus-800 uppercase tracking-wider">Capacidades Extendibles</span>
          <h3 class="text-xl font-bold text-slate-900">¿Su Empresa Necesita una Funcionalidad Especial?</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Gracias a este motor de extensión, construimos en cuestión de días módulos específicos para su sector:
          </p>
          <div class="grid grid-cols-1 gap-2 pt-2">
            {customCapabilities.map((cap) => (
              <div class="flex items-center gap-2 text-xs font-medium text-ficus-900 bg-white px-3 py-1.5 rounded-lg border border-ficus-200/80 shadow-2xs">
                <svg class="w-3.5 h-3.5 text-ficus-700 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                <span>{cap}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
