---
import { getEntry } from 'astro:content';

const heroEntry = await getEntry('sections', '01-hero');
const { Content } = await heroEntry.render();
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden bg-canvas">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      
      <!-- Left Column: Copy & Value Proposition -->
      <div class="lg:col-span-7 space-y-7 text-center lg:text-left">
        
        <!-- Category Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide bg-ficus-100/70 border border-ficus-200 text-ficus-800">
          <span class="w-2 h-2 rounded-full bg-ficus-600 animate-pulse"></span>
          {heroEntry.data.badge}
        </div>

        <!-- Main H1 Heading (Crucial for SEO) -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.14]">
          El Software ERP que <span class="text-ficus-700">Evoluciona al Ritmo</span> de su Negocio
        </h1>

        <!-- Subtitle / Meta Summary -->
        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed max-w-2xl mx-auto lg:mx-0 font-normal">
          {heroEntry.data.subtitle}
        </p>

        <!-- Markdown bullet points -->
        <div class="prose prose-slate max-w-none text-left text-slate-600">
          <Content />
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a 
            href="#contacto" 
            style="background-color: #1e622f; color: #ffffff;"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-3.5 rounded-xl text-base font-bold text-white bg-[#1e622f] hover:bg-[#164e28] transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0"
          >
            <span style="color: #ffffff;">Solicitar Demostración Sin Costo</span>
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href="#modulos" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl text-base font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-300 hover:border-slate-400 transition-all shadow-2xs"
          >
            Explorar Módulos
          </a>
        </div>

        <!-- Metrics -->
        <div class="pt-6 border-t border-slate-200/90 grid grid-cols-3 gap-6 text-center lg:text-left">
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-slate-900">100%</div>
            <div class="text-xs sm:text-sm text-slate-500 font-medium">Operación Continua</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-ficus-700">0\$</div>
            <div class="text-xs sm:text-sm text-slate-500 font-medium">Inversión en Prueba</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-slate-900">Directo</div>
            <div class="text-xs sm:text-sm text-slate-500 font-medium">DIAN sin Intermediarios</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Minimalist Preview -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          
          <!-- Minimalist Card Interface -->
          <div class="relative rounded-3xl bg-white border border-slate-200 p-6 sm:p-7 shadow-sm space-y-6">
            
            <!-- Window Header -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full bg-slate-300"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-slate-300"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-slate-300"></span>
                <span class="ml-2 text-xs font-mono text-slate-400">ficus-core.live</span>
              </div>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-ficus-50 text-ficus-800 border border-ficus-200">
                Sincronización Paralela Activa
              </span>
            </div>

            <!-- ERP Metrics Preview -->
            <div class="space-y-3">
              <div class="p-3.5 rounded-xl bg-canvas border border-slate-200/80 flex items-center justify-between">
                <div>
                  <div class="text-xs font-medium text-slate-500">Facturación Electrónica DIAN</div>
                  <div class="text-base font-bold text-slate-900">12,480 Documentos</div>
                </div>
                <span class="text-xs font-semibold text-ficus-800 bg-ficus-100 px-2.5 py-1 rounded-md">
                  Transmitido 100%
                </span>
              </div>

              <div class="p-3.5 rounded-xl bg-canvas border border-slate-200/80 flex items-center justify-between">
                <div>
                  <div class="text-xs font-medium text-slate-500">Complemento Microsoft Excel</div>
                  <div class="text-base font-bold text-slate-900">Enlace Bidireccional Activo</div>
                </div>
                <span class="text-xs font-semibold text-slate-700 bg-slate-200/70 px-2.5 py-1 rounded-md">
                  Tablas Maestras OK
                </span>
              </div>

              <div class="p-3.5 rounded-xl bg-canvas border border-slate-200/80 flex items-center justify-between">
                <div>
                  <div class="text-xs font-medium text-slate-500">Patrón de Migración</div>
                  <div class="text-base font-bold text-slate-900">Strangler Fig</div>
                </div>
                <span class="text-xs font-semibold text-ficus-800 bg-ficus-100 px-2.5 py-1 rounded-md">
                  Cero Caídas
                </span>
              </div>
            </div>

            <!-- Quote Pill -->
            <div class="p-4 rounded-xl bg-ficus-50/70 border border-ficus-200/70">
              <p class="text-xs text-ficus-950 italic leading-relaxed">
                “Con Ficus no tuvimos que detener la empresa ni un solo día. Nuestros contadores siguen usando Excel, pero ahora conectados a datos en tiempo real.”
              </p>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>
