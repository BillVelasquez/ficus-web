---
import { getEntry } from 'astro:content';

const dilemmaEntry = await getEntry('sections', '03-dilemma');

const comparisons = [
  {
    feature: "Adaptabilidad a Procesos Únicos",
    generic: "Rígida. La empresa debe cambiar para adaptarse al software.",
    custom: "Total, pero cada cambio cuesta meses de desarrollo y dinero.",
    ficus: "Flexible inmediata con diseñador de tablas y flujos sin código."
  },
  {
    feature: "Tiempo de Salida a Producción",
    generic: "Rápido para lo básico, pero se estanca al buscar diferenciación.",
    custom: "Muy lento (6 a 18 meses de desarrollo desde cero).",
    ficus: "Inmediato con módulos preconstruidos y despliegue en paralelo."
  },
  {
    feature: "Riesgo de Fracaso y Parada Operativa",
    generic: "Alto durante el 'Go-Live' masivo (corte abrupto sin retorno).",
    custom: "Extremadamente alto por fallas de arquitectura y bugs.",
    ficus: "Cero. Operación en paralelo y migración gradual Strangler Fig."
  },
  {
    feature: "Manejo de Hojas de Cálculo (Excel)",
    generic: "Se combate o prohíbe; genera islas de datos desconectadas.",
    custom: "Rara vez contemplado o requiere plugins frágiles.",
    ficus: "Complemento nativo bidireccional con auditoría y seguridad."
  },
  {
    feature: "Soporte y Capital Humano",
    generic: "Tickets despersonalizados y bots que tardan días en responder.",
    custom: "Dependencia de 1 o 2 programadores que luego rotan de empleo.",
    ficus: "Ejecutivo de cuenta senior dedicado que contesta al teléfono."
  }
];
---

<section id="dilema" class="py-20 md:py-32 relative overflow-hidden bg-canvas">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold tracking-wide bg-ficus-50 border border-ficus-200 text-ficus-800">
        {dilemmaEntry.data.badge}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        {dilemmaEntry.data.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        {dilemmaEntry.data.subtitle}
      </p>
    </div>

    <!-- The Solution Banner -->
    <div class="mb-16 p-8 sm:p-10 rounded-2xl bg-ficus-50/80 border border-ficus-200 shadow-sm relative overflow-hidden">
      <div class="max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-2 text-ficus-800 text-xs font-bold uppercase tracking-wider">
          <svg class="w-4 h-4 text-ficus-700" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          La Propuesta de Valor Ficus
        </div>
        <h3 class="text-2xl font-bold text-slate-900">
          Lo mejor de la funcionalidad preconstruida + la elasticidad del desarrollo a la medida
        </h3>
        <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
          Para el fabricante de software genérico, su negocio es reducir funcionalidades para masificar. Para su empresa, eso se traduce en quedarse solo tras la venta. Ficus le entrega módulos listos y le da la llave para modelar sus propias ventajas competitivas con acompañamiento real.
        </p>
      </div>
    </div>

    <!-- Comparison Table / Matrix (Mobile Scrollable) -->
    <div class="overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm">
      <table class="w-full text-left text-sm border-collapse min-w-[700px]">
        <thead>
          <tr class="border-b border-slate-200 bg-slate-50">
            <th class="py-5 px-6 font-bold text-slate-800 w-1/4">Criterio de Decisión</th>
            <th class="py-5 px-6 font-semibold text-slate-600 w-1/4">Software Genérico Típico</th>
            <th class="py-5 px-6 font-semibold text-slate-600 w-1/4">Desarrollo Propio a Medida</th>
            <th class="py-5 px-6 font-bold text-ficus-800 w-1/4 bg-ficus-100/60 border-l border-ficus-200">
              Plataforma FICUS
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          {comparisons.map((row) => (
            <tr class="hover:bg-slate-50/80 transition-colors">
              <td class="py-4 px-6 font-semibold text-slate-900">{row.feature}</td>
              <td class="py-4 px-6 text-slate-600">{row.generic}</td>
              <td class="py-4 px-6 text-slate-600">{row.custom}</td>
              <td class="py-4 px-6 text-ficus-900 font-medium bg-ficus-50/50 border-l border-ficus-200">
                <div class="flex items-start gap-2">
                  <svg class="w-4 h-4 text-ficus-700 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  <span>{row.ficus}</span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

  </div>
</section>
