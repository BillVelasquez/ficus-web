---
import { getEntry } from 'astro:content';

const valuePropsEntry = await getEntry('sections', '02-value-props');

const pillars = [
  {
    icon: `<svg class="w-6 h-6 text-ficus-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: "1. Implementación sin Interrupciones",
    highlight: "El Negocio Nunca Debe Parar",
    description: "Puede continuar usando su software actual paralelamente mientras implementa Ficus. Mediante conectores automatizados y sincronización continua, nos encargamos de que ambos sistemas convivan de forma transparente hasta que cada proceso esté 100% verificado y validado.",
    tag: "Metodología Paralela"
  },
  {
    icon: `<svg class="w-6 h-6 text-ficus-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/></svg>`,
    title: "2. Personalización sin Límites",
    highlight: "Adaptable al Milímetro",
    description: "Ficus le permite adaptar la base de datos a sus necesidades exactas, crear sus propios reportes multidimensionales y amoldarse a su estructura organizacional única, exactamente igual a como lo haría un desarrollo a la medida, pero sin sus costos astronómicos.",
    tag: "Arquitectura Dinámica"
  },
  {
    icon: `<svg class="w-6 h-6 text-ficus-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
    title: "3. Excel sin Remordimientos",
    highlight: "La Flexibilidad que su Equipo Ama",
    description: "Sus usuarios pueden seguir utilizando Microsoft Excel para ingresar datos y elaborar análisis avanzados. Con nuestro complemento oficial para Excel, disfrute de toda la velocidad de las hojas de cálculo, pero conectado a una base de datos unificada con orden, permisos y trazabilidad.",
    tag: "Add-in Oficial Excel"
  }
];
---

<section id="beneficios" class="py-20 md:py-28 bg-canvas border-y border-slate-200/70 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold tracking-wide bg-ficus-50 border border-ficus-200 text-ficus-800">
        {valuePropsEntry.data.badge}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        {valuePropsEntry.data.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        {valuePropsEntry.data.subtitle}
      </p>
    </div>

    <!-- 3 Pillars Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {pillars.map((pillar) => (
        <article class="relative flex flex-col justify-between p-8 rounded-2xl bg-white border border-slate-200 hover:border-ficus-500/70 transition-all duration-300 hover:-translate-y-1 group shadow-sm hover:shadow-md">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-xl bg-ficus-50 border border-ficus-100 flex items-center justify-center group-hover:bg-ficus-100/70 transition-colors" set:html={pillar.icon} />
              <span class="text-xs font-semibold px-2.5 py-1 rounded bg-slate-100 text-slate-600">
                {pillar.tag}
              </span>
            </div>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-ficus-700">{pillar.highlight}</span>
              <h3 class="text-xl font-bold text-slate-900 mt-1 group-hover:text-ficus-800 transition-colors">
                {pillar.title}
              </h3>
            </div>
            <p class="text-slate-600 text-sm leading-relaxed">
              {pillar.description}
            </p>
          </div>
          <div class="pt-6 mt-6 border-t border-slate-100 flex items-center gap-2 text-xs font-semibold text-ficus-700 group-hover:text-ficus-800">
            <span>Incluido en la suscripción</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
