---
import { getEntry } from 'astro:content';

const modulesEntry = await getEntry('sections', '04-modules');

const modulesList = [
  {
    id: "contabilidad",
    title: "Contabilidad Multidimensión",
    badge: "NIIF & Normativa",
    description: "Control contable riguroso por terceros, sucursales, centros de costo y proyectos individuales.",
    features: [
      "Modelos Contables y Plantillas de Transacciones dinámicas",
      "Emisión instantánea de Estados Financieros NIIF oficiales",
      "Auditoría y conciliación bancaria asistida",
      "Generador de informes contables parametrizables en Excel"
    ],
    icon: `<svg class="w-6 h-6 text-ficus-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>`
  },
  {
    id: "facturacion",
    title: "Facturación Electrónica DIAN",
    badge: "Documentos Ilimitados",
    description: "Venta ágil de productos y servicios con transmisión inmediata sin costos ocultos por paquete.",
    features: [
      "Facturación recurrente para contratos y suscripciones",
      "Transmisión electrónica directa con la DIAN",
      "Formatos de factura comercial personalizables en PDF",
      "Alertas de vencimiento y remisiones de entrega"
    ],
    icon: `<svg class="w-6 h-6 text-ficus-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`
  },
  {
    id: "cartera",
    title: "Gestión de Cartera & RADIAN",
    badge: "Recuperación de Flujo",
    description: "Trazabilidad detallada de cuentas por cobrar a nivel de cliente y documento con causación tributaria.",
    features: [
      "Control en tiempo real de edades de cartera y mora",
      "Modelos de causación de retenciones (ReteFuente, ReteICA, ReteIVA)",
      "Gestión de eventos del registro RADIAN (título valor)",
      "Reportes de recaudo y proyecciones de flujo de caja"
    ],
    icon: `<svg class="w-6 h-6 text-ficus-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
  },
  {
    id: "proveedores",
    title: "Proveedores & Cuentas por Pagar",
    badge: "Autoservicio B2B",
    description: "Automatización integral del abastecimiento con recepción XML y Documento Soporte Electrónico.",
    features: [
      "Portal web de autoservicio para pre-vinculación de proveedores",
      "Órdenes de compra con validación presupuestal por rubro",
      "Importación desatendida de facturas electrónicas de compras",
      "Documento Soporte Electrónico directo a la DIAN sin límite"
    ],
    icon: `<svg class="w-6 h-6 text-ficus-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>`
  },
  {
    id: "inventario",
    title: "Inventario Multibodega FIFO",
    badge: "Costeo PEPS",
    description: "Exactitud operativa en existencias y costos con jerarquías de bodegas ilimitadas.",
    features: [
      "Creación de bodegas físicas, virtuales y en tránsito",
      "Método de costeo FIFO / PEPS automatizado",
      "Kárdex analítico por producto, lote y vencimiento",
      "Alertas tempranas de stock mínimo y reposición"
    ],
    icon: `<svg class="w-6 h-6 text-ficus-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>`
  },
  {
    id: "nomina",
    title: "Nómina & Nómina Electrónica",
    badge: "Normativa Laboral",
    description: "Cálculo transparente de salarios, prestaciones y transmisión de nómina electrónica a la DIAN.",
    features: [
      "Motor configurable para horas extras, recargos y novedades",
      "Liquidación automática de cesantías, prima y vacaciones",
      "Generación de archivos para operadores PILA",
      "Emisión y envío de desprendibles de pago a colaboradores"
    ],
    icon: `<svg class="w-6 h-6 text-ficus-700" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`
  }
];
---

<section id="modulos" class="py-20 md:py-32 bg-canvas border-y border-slate-200/70 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
      <span class="inline-block px-3.5 py-1 rounded-full text-xs font-semibold tracking-wide bg-ficus-50 border border-ficus-200 text-ficus-800">
        {modulesEntry.data.badge}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        {modulesEntry.data.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        {modulesEntry.data.subtitle}
      </p>
    </div>

    <!-- Modules Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {modulesList.map((mod) => (
        <article class="p-8 rounded-2xl bg-white border border-slate-200 hover:border-ficus-500/70 transition-all duration-300 flex flex-col justify-between group shadow-sm hover:shadow-md">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-xl bg-ficus-50 border border-ficus-100 flex items-center justify-center group-hover:bg-ficus-100/70 transition-colors" set:html={mod.icon} />
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-ficus-50 text-ficus-800 border border-ficus-200">
                {mod.badge}
              </span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 group-hover:text-ficus-800 transition-colors">
              {mod.title}
            </h3>
            <p class="text-sm text-slate-600 leading-relaxed">
              {mod.description}
            </p>
            <ul class="space-y-2 pt-2 border-t border-slate-100">
              {mod.features.map((feat) => (
                <li class="flex items-start gap-2 text-xs sm:text-sm text-slate-700">
                  <svg class="w-4 h-4 text-ficus-700 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="pt-6 mt-6 border-t border-slate-100">
            <a 
              href="#contacto" 
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-ficus-700 hover:text-ficus-800 transition-colors"
            >
              <span>Ver demostración de este módulo</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
